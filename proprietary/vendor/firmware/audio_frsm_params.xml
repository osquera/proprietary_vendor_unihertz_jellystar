<project>
	<param name="calib_spkre_bin" value="/mnt/vendor/persist/factory/audio/frsm_calib.bin" />
	<param name="calib_spkre_wav" value="/vendor/etc/silence_10s.wav" />
	<param name="calib_spkf0_wav" value="/vendor/etc/pinknoise_10s.wav" />
	<param name="card_id" value="0" />
	<param name="log_level" value="0" />

	<device name="SPK1" >
		<param name="spkid" value="1" />
		<param name="re25_min" value="3.1" />
		<param name="re25_max" value="9.6" />
		<param name="f0_min" value="801" />
		<param name="f0_max" value="991" />
	</device>

	<scene name="INIT" >
		<ctl name="SPK1 FSAMP Scene" value="MUSIC" />
		<ctl name="SPK1 FSAMP Volume" value="1023" />
		<ctl name="SPK1 FSAMP DAC_Port Switch" value="0" />
	</scene>

	<scene name="IDLE" >
		<ctl name="SPK1 FSAMP Volume" value="1023" />
		<ctl name="SPK1 FSAMP DAC_Port Switch" value="0" />
	</scene>

	<scene name="MUSIC" >
		<ctl name="SPK1 FSAMP Scene" value="MUSIC" />
		<ctl name="SPK1 FSAMP DAC_Port Switch" value="1" />
	</scene>

	<scene name="VOICE" >
		<ctl name="SPK1 FSAMP Scene" value="VOICE" />
		<ctl name="SPK1 FSAMP DAC_Port Switch" value="1" />
	</scene>

	<scene name="CALIB" >
		<ctl name="SPK1 FSAMP Scene" value="CALIB" />
		<ctl name="SPK1 FSAMP DAC_Port Switch" value="1" />
	</scene>

</project>
